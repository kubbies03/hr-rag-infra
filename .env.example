GOOGLE_API_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Gemini embeddings remove the need to ship a local embedding model on Linux.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_BATCH_SIZE=100
GEMINI_EMBEDDING_TIMEOUT=30

# Optional reranker. Keep disabled for the lightest Linux deployment.
RERANKER_PROVIDER=gemini
USE_RERANKER=false
RERANKER_TIMEOUT=20
RERANKER_MAX_DOC_CHARS=1200
# Lower = more permissive (fewer "no result"), higher = stricter (less noise).
RERANKER_MIN_SCORE=0.3

DATABASE_URL=sqlite:///data/sqlite/hr.db
CHROMA_PERSIST_DIR=data/chroma
DOCS_DIR=data/docs
ANONYMIZED_TELEMETRY=False

APP_ENV=development
APP_DEBUG=true
